  "printWidth": 100,
  "singleQuote": true,
  "semi": true,
  "trailingComma": "all",
  "tabWidth": 2,
  "ignorePatterns": [
    "dist",
    "coverage",
    "pnpm-lock.yaml",
    ".agents",
