{
  "compilerOptions": {
    "target": "ES2023",
    "paths": { "@botharness/ui/panels": ["./packages/client/src/panel-api.ts"] },
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true
  },
  // This mixed Host/Client program merges Cordis Context augmentations.
  // Load the Client session-store declaration explicitly before Host imports:
  // both name ctx.sessions, and the first declaration wins. include ordering
  // alone is insufficient when an early Client file gains a Host import chain.
  "files": ["packages/client/src/dsh-client-context.d.ts"],
  "include": [
    "packages/client/src",
    "packages/host-client/src",
    "packages/host-protocol/src",
    "packages/computer/src",
    "packages/vrm-companion/src",
    "packages/core/src",
    "packages/deepseekbot/src",
    "packages/browser/src",
    "packages/todo/src",
    "packages/market/src",
    "packages/ingest/src",
    "packages/links/src",
    "packages/links-cli/src",
    "packages/connect-relay/src",
    "packages/*/test",
    "apps/mobile/test/host",
    "*.config.ts"
  ],
  "exclude": [
    "apps/mobile/test/swipe-chat-target.test.ts",
    "apps/mobile/test/host-session-ios-call-resume.test.ts",
    "apps/mobile/test/host-session-ios-in-app.test.ts",
    "apps/mobile/test/reanimated-shim.ts",
    "apps/mobile/test/motion-springs.test.ts",
    "apps/mobile/test/back-owner.test.ts",
    "apps/mobile/test/viewer-header.test.tsx",
    "apps/mobile/test/workspace-panel-root.test.ts",
    "apps/mobile/test/platform-tokens.test.ts",
    "apps/mobile/test/**/*.tsx"
  ]
}
