{
  "compilerOptions": {
    "target": "ES2023",
    "paths": { "@botharness/ui/panels": ["./packages/client/src/panel-api.ts"] },
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true
  },
  // This mixed Host/Client program merges Cordis Context augmentations.
  // Load the Client session-store declaration explicitly before Host imports:
  // both name ctx.sessions, and the first declaration wins. include ordering
  // alone is insufficient when an early Client file gains a Host import chain.
  "files": ["packages/client/src/dsh-client-context.d.ts"],
  "include": [
    "packages/client/src",
    "packages/host-client/src",
    "packages/host-protocol/src",
    "packages/computer/src",
    "packages/vrm-companion/src",
    "packages/core/src",
    "packages/deepseekbot/src",
    "packages/browser/src",
    "packages/todo/src",
    "packages/market/src",
    "packages/ingest/src",
    "packages/links/src",
    "packages/links-cli/src",
    "packages/connect-relay/src",
    "packages/*/test",
    "apps/mobile/test/host",
    "*.config.ts"
  ],
  "exclude": [
    "apps/mobile/test/playback-runtime.test.ts",
    "apps/mobile/test/notification-preferences-web.test.ts",
    "apps/mobile/test/posthog-sender.test.ts",
    "apps/mobile/test/catch-up-power.test.ts",
    "apps/mobile/test/mobile-telemetry-wire-live.test.ts",
    "apps/mobile/test/native-telemetry.test.ts",
    "apps/mobile/test/native-push-resolve.test.ts",
    "apps/mobile/test/native-connection-mode.test.ts",
    "apps/mobile/test/native-lan-socket.test.ts",
    "apps/mobile/test/call-camera.test.ts",
    "apps/mobile/test/call-media-native.test.ts",
    "apps/mobile/test/os-dictation.test.ts",
    "apps/mobile/test/call-activity-avatar.test.ts",
    "apps/mobile/test/native-persistence.test.ts",
    "apps/mobile/test/native-zip-import-file.test.ts",
    "apps/mobile/test/share-attachment.test.ts",
    "apps/mobile/test/media-cache.test.ts",
    "apps/mobile/test/share-versioned.test.ts",
    "apps/mobile/test/purge-caches.test.ts",
    "apps/mobile/test/haptic-feedback.test.ts",
    "apps/mobile/test/native-chat-background.test.ts",
    "apps/mobile/test/inbox-screens.test.ts",
    "apps/mobile/test/action-cards.test.ts",
    "apps/mobile/test/activity-feed.test.ts",
    "apps/mobile/test/open-conversation.test.ts",
    "apps/mobile/test/quick-action-routing.test.ts",
    "apps/mobile/test/incoming-share.test.ts",
    "apps/mobile/test/recent-chats.test.ts",
    "apps/mobile/test/grant-request-card.test.ts",
    "apps/mobile/test/attention-actions.test.ts",
    "apps/mobile/test/host-session-unpair.test.ts",
    "apps/mobile/test/host-session-multiple.test.ts",
    "apps/mobile/test/host-session-background.test.ts",
    "apps/mobile/test/conversation-cache-host.test.ts",
    "apps/mobile/test/native-conversation-cache.test.ts",
    "apps/mobile/test/chats-search-results.test.ts"
  ]
}
