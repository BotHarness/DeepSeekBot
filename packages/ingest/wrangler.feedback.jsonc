{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "botharness-feedback",
  "main": "src/feedback-worker.ts",
  "compatibility_date": "2026-09-17",
  "r2_buckets": [{ "binding": "FEEDBACK_BUCKET", "bucket_name": "botharness-feedback-private" }],
  "triggers": { "crons": ["*/5 * * * *"] },
  "ratelimits": [
    {
      "name": "FEEDBACK_RATE_LIMITER",
      "namespace_id": "2811",
      "simple": { "limit": 10, "period": 60 },
    },
  ],
}
