{
  "$schema": "node_modules/wrangler/config-schema.json",
  // hosted Connect relay (ADR-0241); never on a subdomain of the deepseekbot.dev tunnel zone
  "name": "botharness-connect-relay",
  "account_id": "332e72d480d7cb3e60ee671d3ca0cad0",
  "main": "src/entry.ts",
  "compatibility_date": "2026-09-17",
  "routes": [{ "pattern": "connect.botharness.ai", "custom_domain": true }],
  // reclaim tunnels whose Host stayed offline longer than RECLAIM_AFTER_MINUTES
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    "CONNECT_ZONE": "deepseekbot.dev",
    "MAX_HOSTS": "3",
    // stay under Cloudflare's 1000 tunnels per account
    "MAX_TUNNELS": "980",
    // shared zones as name=zone-id:tunnel-records; each free zone holds 200 records including its other records
    "CONNECT_ZONES": "botharness.dev=bcc7b7abd754fa14e039683e632860ce:195,kite-u.com=19428ce1cf312d024fced7c15af5286a:194,tobs.app=570c931bc71847d323543aaa9e49c7bb:194,deepseekbot.app=d4958f63380ee58644f8142072d4713b:189,botharness.ai=4bd1e8b9260f06c0e0826177dbbcb9a4:188",
    "RECLAIM_AFTER_MINUTES": "5",
  },
  // secrets: WORKOS_CLIENT_ID, CLOUDFLARE_API_TOKEN, CLOUDFLARE_ACCOUNT_ID, CLOUDFLARE_ZONE_ID, CONNECT_HOST_KEY, WORKOS_API_KEY; optional ALLOWED_USERS
  // Approximate per-location POST cap: 20/minute per account for Human operations;
  // Bot identity/grant requests use a separate account + owned Host key in the same limiter.
  "ratelimits": [
    { "name": "CONNECT_LIMIT", "namespace_id": "2387", "simple": { "limit": 20, "period": 60 } },
    {
      "name": "CONNECT_READ_LIMIT",
      "namespace_id": "2388",
      "simple": { "limit": 60, "period": 60 },
    },
  ],
  // Deleting a Connect account also deletes its Uploaded Bots in the Bot Marketplace (ADR-0267)
  "services": [{ "binding": "MARKET", "service": "botharness-market" }],
  "d1_databases": [
    {
      "binding": "CONNECT_DB",
      "database_name": "botharness-connect-relay",
      "database_id": "f4fa5c3d-81d5-4edf-b4b4-c3b045043d43",
      "migrations_dir": "migrations",
    },
  ],
}
