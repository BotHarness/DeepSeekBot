{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "botharness-market",
  "account_id": "332e72d480d7cb3e60ee671d3ca0cad0",
  "main": "src/entry.ts",
  "compatibility_date": "2026-09-17",
  "routes": [{ "pattern": "market.botharness.ai", "custom_domain": true }],
  "triggers": { "crons": ["0 3 * * *", "17 * * * *"] },
  // secrets: GITHUB_TOKEN, ALTCHA_HMAC_KEY, ADMIN_TOKEN, SUMMARY_API_KEY, WORKOS_CLIENT_ID (Connect's
  // WorkOS client, for Uploaded Bot sign-in; uploads answer uploads-unavailable without it)
  // Uploaded Bot files, one object per path under bots/<id>/ (ADR-0267)
  "r2_buckets": [{ "binding": "MARKET_FILES", "bucket_name": "botharness-market-files" }],
  "d1_databases": [
    {
      "binding": "MARKET_DB",
      "database_name": "botharness-market",
      "database_id": "bbe172e8-ff79-4923-b297-e11cf211d38c",
      "migrations_dir": "migrations",
    },
  ],
}
