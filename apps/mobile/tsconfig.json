{
  "extends": "expo/tsconfig.base.json",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["node"],
    "noEmit": true
  },
  "include": [
    "app",
    "src",
    "test/posthog-sender.test.ts",
    "test/mobile-telemetry-wire-live.test.ts",
    "test/native-telemetry.test.ts",
    "test/native-persistence.test.ts",
    "test/native-zip-import-file.test.ts",
    "test/share-attachment.test.ts",
    "test/haptic-feedback.test.ts",
    "test/inbox-screens.test.ts",
    "test/action-cards.test.ts",
    "test/activity-feed.test.ts",
    "test/host-session-unpair.test.ts",
    "test/host-session-multiple.test.ts",
    "test/conversation-cache-host.test.ts",
    "test/reanimated-shim.ts",
    "test/platform-tokens.test.ts",
    "test/**/*.tsx"
  ]
}
