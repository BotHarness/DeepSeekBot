diff --git a/apps/desktop/src/window-capture.ts b/apps/desktop/src/window-capture.ts
new file mode 100644
--- /dev/null
+++ b/apps/desktop/src/window-capture.ts
@@ -0,0 +1,63 @@
+/** Native pixels for the calling application window; no window selector crosses IPC. */
+import type { BrowserWindow, IpcMain, IpcMainInvokeEvent } from 'electron'
+
+const CHANNEL = 'dsh-desktop:window-capture'
+const LIMIT = 25 * 1024 * 1024
+
+/**
+ * Install once for the application lifetime. The existing main-application
+ * authority rejects guest renderers, child frames and non-application origins.
+ */
+export function installDesktopWindowCapture(
+  ipc: Pick<IpcMain, 'handle' | 'removeHandler'>,
+  owner: (event: IpcMainInvokeEvent) => BrowserWindow,
+): () => void {
+  let busy = false
+  let disposed = false
+  ipc.handle(CHANNEL, async (event, ...args: unknown[]) => {
+    if (disposed || args.length !== 0) throw new Error('capture-invalid-request')
+    const window = owner(event)
+    const contents = window.webContents
+    const frame = event.senderFrame
+    const url = frame?.url
+    let navigated = false
+    const navigate = (_event: Electron.Event, _url: string, _inPlace: boolean, mainFrame: boolean): void => {
+      if (mainFrame) navigated = true
+    }
+    const valid = (): boolean => !disposed && !navigated && !window.isDestroyed()
+      && !contents.isDestroyed() && window.isVisible() && !window.isMinimized()
+      && event.sender === contents && frame === contents.mainFrame
+      && frame?.url === url && url !== undefined
+      && url.startsWith('dsh-app://app/')
+    if (!valid()) throw new Error('capture-window-unavailable')
+    if (busy) throw new Error('capture-busy')
+    busy = true
+    contents.on('did-start-navigation', navigate)
+    // Keep the busy lease until Chromium settles even if the caller times out.
+    const work = (async () => {
+      try {
+        const image = await contents.capturePage()
+        if (!valid() || owner(event) !== window) throw new Error('capture-window-changed')
+        if (image.isEmpty()) throw new Error('capture-empty')
+        const png = image.toPNG()
+        if (png.byteLength === 0 || png.byteLength > LIMIT) throw new Error('capture-size-limit')
+        return { bytes: Uint8Array.from(png), mediaType: 'image/png' as const }
+      } finally {
+        contents.removeListener('did-start-navigation', navigate)
+        busy = false
+      }
+    })()
+    let timer: ReturnType<typeof setTimeout> | undefined
+    try {
+      return await Promise.race([work, new Promise<never>((_, reject) => {
+        timer = setTimeout(() => { reject(new Error('capture-timeout')) }, 2_500)
+      })])
+    } finally {
+      clearTimeout(timer)
+    }
+  })
+  return () => {
+    disposed = true
+    ipc.removeHandler(CHANNEL)
+  }
+}
