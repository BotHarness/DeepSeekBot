    "accent": {
      "classic-blue": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.2039, 0.4, 0.8588],
          "hex": "#3466db"
        }
      },
      "mist-purple": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.4745, 0.3412, 0.7882],
          "hex": "#7957c9"
        }
      },
      "forest-green": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.1569, 0.4549, 0.3294],
          "hex": "#287454"
        }
      },
      "warm-amber": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.5804, 0.3765, 0.051],
          "hex": "#94600d"
        }
      }
    },
    "status": {
      "red": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.8157, 0.1882, 0.1725],
