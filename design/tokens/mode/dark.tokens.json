          "ink": {
            "$type": "color",
            "$value": {
              "colorSpace": "srgb",
              "components": [0.4784, 0.851, 0.6314],
              "hex": "#7ad9a1"
            }
          }
        },
        "info": {
          "base": {
            "$type": "color",
            "$value": "{web.color.accent.solid}"
          },
          "tint": {
            "$type": "color",
            "$value": "{web.color.accent.tint}"
          },
          "ink": {
            "$type": "color",
            "$value": "{web.color.accent.ink}"
          }
        }
      }
    },
