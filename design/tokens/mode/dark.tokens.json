{
  "$description": "Tobs dark mode: palettes, surfaces, ink, lines, states, status roles and elevation. Accent roles are derived at build time from palette.accent.",
  "palette": {
    "accent": {
      "classic-blue": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.4706, 0.6275, 1.0],
          "hex": "#78a0ff"
        }
      },
      "mist-purple": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.6941, 0.6039, 0.9412],
          "hex": "#b19af0"
        }
      },
      "forest-green": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.4863, 0.7804, 0.6275],
          "hex": "#7cc7a0"
        }
      },
      "warm-amber": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.902, 0.7176, 0.3608],
          "hex": "#e6b75c"
        }
      }
    },
    "status": {
      "red": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [1.0, 0.4784, 0.4471],
          "hex": "#ff7a72"
        }
      },
      "amber": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.949, 0.702, 0.2392],
          "hex": "#f2b33d"
        }
      },
      "green": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.2706, 0.7882, 0.4863],
          "hex": "#45c97c"
        }
      }
    }
  },
