            "components": [1.0, 1.0, 1.0],
            "alpha": 0.0627,
            "hex": "#ffffff"
          }
        },
        "edge": {
          "$type": "color",
          "$value": {
            "colorSpace": "srgb",
            "components": [1.0, 1.0, 1.0],
