            },
            "blur": {
              "value": 20,
              "unit": "px"
            },
            "spread": {
              "value": -4,
              "unit": "px"
            }
          }
        ]
      },
      "3": {
        "$type": "shadow",
        "$value": [
          {
            "color": {
              "colorSpace": "srgb",
              "components": [1.0, 1.0, 1.0],
              "alpha": 0.0706,
              "hex": "#ffffff"
            },
            "offsetX": {
              "value": 0,
              "unit": "px"
            },
            "offsetY": {
              "value": 0,
              "unit": "px"
            },
            "blur": {
              "value": 0,
              "unit": "px"
            },
            "spread": {
              "value": 1,
              "unit": "px"
            }
          },
          {
            "color": {
              "colorSpace": "srgb",
              "components": [0.0, 0.0, 0.0],
              "alpha": 0.702,
              "hex": "#000000"
            },
            "offsetX": {
              "value": 0,
              "unit": "px"
            },
            "offsetY": {
              "value": 16,
              "unit": "px"
            },
            "blur": {
              "value": 40,
              "unit": "px"
            },
            "spread": {
              "value": -8,
              "unit": "px"
            }
          }
        ]
      }
    }
  }
}
