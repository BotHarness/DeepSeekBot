{
  "$description": "Tobs dark mode: palettes, surfaces, ink, lines, states, status roles and elevation. Accent roles are derived at build time from palette.accent.",
  "palette": {
    "accent": {
      "classic-blue": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.4706, 0.6275, 1.0],
          "hex": "#78a0ff"
        }
      },
      "mist-purple": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.6941, 0.6039, 0.9412],
          "hex": "#b19af0"
        }
      },
      "forest-green": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.4863, 0.7804, 0.6275],
          "hex": "#7cc7a0"
        }
      },
      "warm-amber": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.902, 0.7176, 0.3608],
          "hex": "#e6b75c"
        }
      }
    },
    "status": {
      "red": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [1.0, 0.4784, 0.4471],
          "hex": "#ff7a72"
        }
      },
      "amber": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.949, 0.702, 0.2392],
          "hex": "#f2b33d"
        }
      },
      "green": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.2706, 0.7882, 0.4863],
          "hex": "#45c97c"
        }
      }
    }
  },
  "web": {
    "color": {
      "layer": {
        "canvas": {
          "$type": "color",
          "$value": "{palette.neutral.11}"
        },
        "raised": {
          "$type": "color",
          "$value": "{palette.neutral.15}"
        },
        "well": {
          "$type": "color",
          "$value": "{palette.neutral.18}"
        },
        "field": {
          "$type": "color",
          "$value": "{palette.neutral.9}"
        },
        "nav": {
          "$type": "color",
          "$value": "{palette.neutral.10}"
        },
        "sheet": {
          "$type": "color",
          "$value": "{palette.neutral.13}"
        },
        "elevated": {
          "$type": "color",
          "$value": "{palette.neutral.20}"
        },
        "scrim": {
          "$type": "color",
          "$value": {
            "colorSpace": "srgb",
            "components": [0.0, 0.0, 0.0],
            "alpha": 0.502,
            "hex": "#000000"
          }
        },
        "clear": {
          "$type": "color",
          "$value": {
            "colorSpace": "srgb",
            "components": [0.0, 0.0, 0.0],
            "alpha": 0.0,
            "hex": "#000000"
          },
          "$description": "No fill; lets a style turn a surface off without carrying a colour value."
        }
      },
      "ink": {
        "primary": {
          "$type": "color",
          "$value": "{palette.neutral.96}"
        },
        "secondary": {
          "$type": "color",
          "$value": "{palette.neutral.68}"
        },
        "tertiary": {
          "$type": "color",
          "$value": "{palette.neutral.61}",
          "$description": "Lowest text ink; still 4.5:1 on every surface."
        },
        "quiet": {
          "$type": "color",
          "$value": {
            "colorSpace": "srgb",
            "components": [0.5255, 0.5451, 0.5804],
            "hex": "#868b94"
          },
          "$description": "Icons and decoration only, 3:1; never text."
        },
        "disabled": {
          "$type": "color",
          "$value": {
            "colorSpace": "srgb",
            "components": [0.3529, 0.3686, 0.3961],
            "hex": "#5a5e65"
          }
        }
      },
      "line": {
        "divider": {
          "$type": "color",
          "$value": {
            "colorSpace": "srgb",
            "components": [1.0, 1.0, 1.0],
            "alpha": 0.0627,
            "hex": "#ffffff"
          }
        },
        "edge": {
          "$type": "color",
          "$value": {
            "colorSpace": "srgb",
            "components": [1.0, 1.0, 1.0],
            "alpha": 0.1216,
            "hex": "#ffffff"
          }
        },
        "strong": {
          "$type": "color",
          "$value": {
            "colorSpace": "srgb",
            "components": [1.0, 1.0, 1.0],
            "alpha": 0.1882,
            "hex": "#ffffff"
          }
        },
        "focus": {
          "$type": "color",
          "$value": "{web.color.accent.focus}"
        }
      },
      "state": {
        "hover": {
          "$type": "color",
          "$value": {
            "colorSpace": "srgb",
            "components": [1.0, 1.0, 1.0],
            "alpha": 0.051,
            "hex": "#ffffff"
          }
        },
        "pressed": {
          "$type": "color",
          "$value": {
            "colorSpace": "srgb",
            "components": [1.0, 1.0, 1.0],
            "alpha": 0.0902,
            "hex": "#ffffff"
          }
        },
        "selected": {
          "$type": "color",
          "$value": {
            "colorSpace": "srgb",
            "components": [0.1843, 0.1922, 0.2118],
            "hex": "#2f3136"
          },
          "$description": "Neutral selected fill, as in the style A prototype; selection also sets ink and weight."
        },
        "selected-ink": {
          "$type": "color",
          "$value": "{web.color.ink.primary}"
        }
      },
      "status": {
        "danger": {
          "base": {
            "$type": "color",
            "$value": "{palette.status.red}"
          },
          "tint": {
            "$type": "color",
            "$value": {
              "colorSpace": "srgb",
              "components": [0.2314, 0.1294, 0.1255],
              "hex": "#3b2120"
            }
          },
          "ink": {
            "$type": "color",
            "$value": {
              "colorSpace": "srgb",
              "components": [1.0, 0.6078, 0.5804],
              "hex": "#ff9b94"
            }
          }
        },
        "warning": {
          "base": {
            "$type": "color",
            "$value": "{palette.status.amber}"
          },
          "tint": {
            "$type": "color",
            "$value": {
              "colorSpace": "srgb",
              "components": [0.2275, 0.1765, 0.0784],
              "hex": "#3a2d14"
            }
          },
          "ink": {
            "$type": "color",
            "$value": {
              "colorSpace": "srgb",
              "components": [0.9647, 0.7804, 0.4392],
              "hex": "#f6c770"
            }
          }
        },
        "success": {
          "base": {
            "$type": "color",
            "$value": "{palette.status.green}"
          },
          "tint": {
            "$type": "color",
            "$value": {
              "colorSpace": "srgb",
              "components": [0.0902, 0.2, 0.1412],
              "hex": "#173324"
            }
          },
          "ink": {
            "$type": "color",
            "$value": {
              "colorSpace": "srgb",
              "components": [0.4784, 0.851, 0.6314],
              "hex": "#7ad9a1"
            }
          }
        },
        "info": {
          "base": {
            "$type": "color",
            "$value": "{web.color.accent.solid}"
          },
          "tint": {
            "$type": "color",
            "$value": "{web.color.accent.tint}"
          },
          "ink": {
            "$type": "color",
            "$value": "{web.color.accent.ink}"
          }
        }
      }
    },
    "elevation": {
      "1": {
        "$type": "shadow",
        "$value": [
          {
            "color": {
              "colorSpace": "srgb",
              "components": [1.0, 1.0, 1.0],
              "alpha": 0.0588,
              "hex": "#ffffff"
            },
            "offsetX": {
              "value": 0,
              "unit": "px"
            },
            "offsetY": {
              "value": 0,
              "unit": "px"
            },
            "blur": {
              "value": 0,
              "unit": "px"
            },
            "spread": {
              "value": 1,
              "unit": "px"
            }
          }
        ]
      },
      "2": {
        "$type": "shadow",
        "$value": [
          {
            "color": {
              "colorSpace": "srgb",
              "components": [1.0, 1.0, 1.0],
              "alpha": 0.0706,
              "hex": "#ffffff"
            },
            "offsetX": {
              "value": 0,
              "unit": "px"
            },
            "offsetY": {
              "value": 0,
              "unit": "px"
            },
            "blur": {
              "value": 0,
              "unit": "px"
            },
            "spread": {
              "value": 1,
              "unit": "px"
            }
          },
          {
            "color": {
              "colorSpace": "srgb",
              "components": [0.0, 0.0, 0.0],
              "alpha": 0.502,
              "hex": "#000000"
            },
            "offsetX": {
              "value": 0,
              "unit": "px"
            },
