diff --git a/ios/StablePagerController.swift b/ios/StablePagerController.swift
new file mode 100644
index 0000000000000000000000000000000000000000..b68abd16f1a9d63eef1e4c9945f877a1fb900f90
--- /dev/null
+++ b/ios/StablePagerController.swift
@@ -0,0 +1,154 @@
+import UIKit
+
+final class StablePagerController: UIPageViewController, UIPageViewControllerDataSource, UIPageViewControllerDelegate {
+  private let props: PagerViewProps
+  private weak var events: PagerViewProviderDelegate?
+  private var retained: [ObjectIdentifier: PageChildViewController] = [:]
+  private var pages: [PageChildViewController] = []
+  private var selected = -1
+  private var moving = false
+  private var interactiveTransition = false
+  private var pending: (Int, Bool)?
+  private var observation: NSKeyValueObservation?
+  private weak var scroll: UIScrollView?
+
+  init(props: PagerViewProps, events: PagerViewProviderDelegate?) {
+    self.props = props
+    self.events = events
+    super.init(transitionStyle: .scroll, navigationOrientation: props.orientation == .vertical ? .vertical : .horizontal)
+    dataSource = self
+    delegate = self
+  }
+
+  required init?(coder: NSCoder) { fatalError("init(coder:) is unavailable") }
+
+  override func viewDidLoad() {
+    super.viewDidLoad()
+    view.backgroundColor = .clear
+    scroll = view.subviews.compactMap { $0 as? UIScrollView }.first
+    scroll?.scrollsToTop = false
+    scroll?.panGestureRecognizer.addTarget(self, action: #selector(panChanged(_:)))
+    if #available(iOS 26.0, *) {
+      scroll?.topEdgeEffect.isHidden = true
+      scroll?.bottomEdgeEffect.isHidden = true
+      scroll?.leftEdgeEffect.isHidden = true
+      scroll?.rightEdgeEffect.isHidden = true
+    }
+    observation = scroll?.observe(\.contentOffset, options: [.new]) { [weak self] _, _ in self?.progress() }
+    refresh()
+  }
+
+  func refresh() {
+    guard isViewLoaded, !moving else { return }
+    scroll?.isScrollEnabled = props.scrollEnabled
+    scroll?.keyboardDismissMode = props.keyboardDismissMode
+    let live = Set(props.children.map { ObjectIdentifier($0.view) })
+    retained = retained.filter { live.contains($0.key) }
+    let next = props.children.prefix(props.eligibleCount).map { child in
+      let key = ObjectIdentifier(child.view)
+      if let controller = retained[key] { return controller }
+      let controller = PageChildViewController()
+      controller.wrappedView = child.view
+      retained[key] = controller
+      return controller
+    }
+    let changed = pages.count != next.count || zip(pages, next).contains { $0 !== $1 }
+    pages = next
+    guard !pages.isEmpty else { return }
+    let index = min(max(props.currentPage, 0), pages.count - 1)
+    if changed {
+      dataSource = nil
+      dataSource = self
+    }
+    if viewControllers?.first !== pages[index] {
+      setViewControllers([pages[index]], direction: index < selected ? .reverse : .forward, animated: false)
+    }
+    if changed || selected != index { finish(index) }
+  }
+
+  func move(to index: Int, animated: Bool) {
+    guard index >= 0, index < pages.count else { return }
+    if moving { pending = (index, animated); return }
+    guard selected != index else { return }
+    moving = true
+    events?.onPageScrollStateChanged(state: .settling)
+    setViewControllers([pages[index]], direction: index < selected ? .reverse : .forward, animated: animated) { [weak self] _ in
+      guard let self else { return }
+      self.moving = false
+      self.finish(index)
+      self.resume()
+    }
+  }
+
+  private func finish(_ index: Int) {
+    props.currentPage = index
+    if selected != index {
+      selected = index
+      events?.onPageSelected(position: index)
+    }
+    events?.onPageScroll(data: OnPageScrollEventData(position: Double(index), offset: 0))
+    events?.onPageScrollStateChanged(state: .idle)
+  }
+
+  private func resume() {
+    refresh()
+    if let (index, animated) = pending {
+      pending = nil
+      move(to: index, animated: animated)
+    }
+  }
+
+  @objc private func panChanged(_ pan: UIPanGestureRecognizer) {
+    switch pan.state {
+    case .began:
+      moving = true
+      events?.onPageScrollStateChanged(state: .dragging)
+    case .ended:
+      events?.onPageScrollStateChanged(state: .settling)
+      if !interactiveTransition {
+        moving = false
+        finish(max(selected, 0))
+        resume()
+      }
+    case .cancelled, .failed:
+      if !interactiveTransition {
+        moving = false
+        finish(max(selected, 0))
+        resume()
+      }
+    default: break
+    }
+  }
+
+  private func progress() {
+    guard let scroll, selected >= 0, !pages.isEmpty else { return }
+    let vertical = props.orientation == .vertical
+    let size = vertical ? scroll.bounds.height : scroll.bounds.width
+    guard size > 0 else { return }
+    let distance = (vertical ? scroll.contentOffset.y : scroll.contentOffset.x) / size - 1
+    let value = min(max(Double(selected) + Double(distance), 0), Double(pages.count - 1))
+    events?.onPageScroll(data: OnPageScrollEventData(position: floor(value), offset: value - floor(value)))
+  }
+
+  func pageViewController(_ pageViewController: UIPageViewController, viewControllerBefore viewController: UIViewController) -> UIViewController? {
+    guard let index = pages.firstIndex(where: { $0 === viewController }), index > 0 else { return nil }
+    return pages[index - 1]
+  }
+
+  func pageViewController(_ pageViewController: UIPageViewController, viewControllerAfter viewController: UIViewController) -> UIViewController? {
+    guard let index = pages.firstIndex(where: { $0 === viewController }), index + 1 < pages.count else { return nil }
+    return pages[index + 1]
+  }
+
+  func pageViewController(_ pageViewController: UIPageViewController, willTransitionTo pendingViewControllers: [UIViewController]) {
+    moving = true
+    interactiveTransition = true
+  }
+
+  func pageViewController(_ pageViewController: UIPageViewController, didFinishAnimating finished: Bool, previousViewControllers: [UIViewController], transitionCompleted completed: Bool) {
+    moving = false
+    interactiveTransition = false
+    if let current = viewControllers?.first, let index = pages.firstIndex(where: { $0 === current }) { finish(index) }
+    resume()
+  }
+}
